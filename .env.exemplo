# INSTRUÇÕES:
# 1. Copie este arquivo e renomeie para ".env" (sem extensão)
# 2. Obtenha sua chave gratuita em: https://aistudio.google.com/apikey
# 3. Substitua "sua_chave_aqui" pela chave do Google Gemini
# 4. Salve o arquivo e reinicie EstokeAoCubo

# Sua chave de API do Google Gemini
GEMINI_API_KEY=sua_chave_aqui

# Credenciais do Mercado Pago (Produção ou Sandbox)
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
MERCADO_PAGO_CLIENT_ID=xxxxxxxxxxxxxx
MERCADO_PAGO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
